<script>
function deleteProduct(name) {
    if (!confirm(`Are you sure you want to remove ${name}?`)) {
    return;
    }

    fetch(`/products/${name}`, {
    method: "DELETE",
    }).then((response) => {
    console.log(response);
    if (response.ok) {
        window.location.reload();
    } else {
        alert("Error while removing product.");
    }
    });
}
</script>